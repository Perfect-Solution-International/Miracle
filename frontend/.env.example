# ---------------------------------------------------------------------------
# Public variables (inlined into the browser bundle — NEVER put secrets here)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Server-only variables (never prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Origin of the Rust backend. Only the BFF route handlers in src/app/api call it.
RUST_API_URL=http://localhost:8080
RUST_API_TIMEOUT_MS=15000

# Names of the HTTP-only cookies issued by the BFF.
SESSION_COOKIE_NAME=mi_session
REFRESH_COOKIE_NAME=mi_refresh
