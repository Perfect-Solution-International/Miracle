# Server Configuration
PORT=8080
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL=postgres://miracle_user:miracle_password@localhost:5432/miracle_db

# JWT Security
JWT_SECRET=miracle_super_secret_jwt_key_development_only_2026
ACCESS_TOKEN_TTL_MINUTES=60

# Refresh tokens (opaque, rotated on every use)
REFRESH_TOKEN_TTL_DAYS=30
SESSION_REFRESH_TTL_HOURS=24

# Single-use links sent by email
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# Logging
RUST_LOG=miracle_server=debug,tower_http=info,axum=trace
